# GitHub Issue Compliance Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# BOSA MCP Authentication (REQUIRED)
# Get these from your BOSA account at https://api.bosa.id
BOSA_API_KEY_CLIENT=your-bosa-api-key-here
BOSA_USER_SECRET=your-bosa-user-secret-here

# AIP Platform Configuration (REQUIRED) 
# Get these from your AIP platform administrator
AIP_API_URL=https://your-aip-instance.com
AIP_API_KEY=your-aip-api-key-here

# GitHub Project Configuration (OPTIONAL)
# Override default values if needed
GITHUB_ORGANIZATION=GDP-ADMIN
GITHUB_PROJECT_ID=223

# Development/Testing Options (OPTIONAL)
DEBUG_MODE=false
DRY_RUN_MODE=false

# Logging Configuration (OPTIONAL)
LOG_LEVEL=INFO
LOG_FILE=agent_creator.log